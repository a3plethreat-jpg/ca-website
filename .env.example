# Optional site config (all have defaults in app/lib/content.ts)
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_WHATSAPP=
NEXT_PUBLIC_CONTACT_LOCATION=
NEXT_PUBLIC_SOCIAL_FACEBOOK=
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_YOUTUBE=
# Dudoy chat assistant endpoint (falls back to built-in answers if unset/unreachable)
NEXT_PUBLIC_DUDOY_CHAT_URL=https://dudoy.coachatriplethreat.com/chat
# Inquiry form delivery. Gmail API is used if all GMAIL_* are set, else Resend (https://resend.com); if neither, submissions are only logged.
# Gmail: create an OAuth client (Desktop/Web) in Google Cloud, enable the Gmail API, and get a refresh token for the sender account with scope https://www.googleapis.com/auth/gmail.send
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER=
GMAIL_SENDER_NAME=CA Triple Threat Basketball Camp
RESEND_API_KEY=
INQUIRY_TO_EMAIL=info@coachatriplethreat.com
INQUIRY_FROM_EMAIL=
# Optional per-type staff routing (JSON). Types: Basketball Camp, Training Schedule, Coaching Inquiry, Partnership, Other. Unmapped types go to INQUIRY_TO_EMAIL.
# INQUIRY_ROUTES={"Basketball Camp":"coach@example.com","Partnership":"a@example.com,b@example.com"}
# Optional: embed a real live stream in the corner screen (YouTube/Facebook https URL)
NEXT_PUBLIC_LIVE_STREAM_URL=
